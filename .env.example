# OpenRouter API Key (для генерации эмбеддингов и ответов LLM)
# Получить: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Pinecone API Key (для векторной базы данных)
# Получить: https://app.pinecone.io/
PINECONE_KEY=pcsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram Bot Token (для запуска бота)
# Получить: https://t.me/BotFather
TELEGRAM_KEY=0000000000:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Название индекса Pinecone (по умолчанию: test2, размерность: 1536, метрика: cosine)
PINECONE_INDEX=test2

# Порог косинусного сходства (Cosine Similarity) для автоматической фильтрации дубликатов (0.0 - 1.0)
DUPLICATE_THRESHOLD=0.88

