# Базовый URL для OpenAI-совместимого API (OpenRouter, OpenAI или локальный прокси)
# По умолчанию: https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# API Key для эмбеддингов и LLM (поддерживаются OPENROUTER_API_KEY и OPENAI_API_KEY)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Pinecone API Key (для векторной базы данных)
# Получить: https://app.pinecone.io/
PINECONE_KEY=pcsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram Bot Token (для запуска бота)
# Получить: https://t.me/BotFather
TELEGRAM_KEY=0000000000:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Название индекса Pinecone (по умолчанию: test2, размерность: 1536, метрика: cosine)
PINECONE_INDEX=test2

# Порог косинусного сходства (Cosine Similarity) для автоматической фильтрации дубликатов (0.0 - 1.0)
DUPLICATE_THRESHOLD=0.88

# Файл для сохранения результатов логирования дедупликации (action: created / updated / skipped)
LOG_FILE=deduplication.log


